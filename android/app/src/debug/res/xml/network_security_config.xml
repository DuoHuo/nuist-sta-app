<?xml version="1.0" encoding="utf-8"?>
<!--
  仅 debug 源集：信任用户手动安装的 CA 证书，让 mitmproxy / Charles 这类
  抓包代理能解开 App（含 WebView）的 HTTPS 流量。release 构建不包含本文件，
  线上只信任系统证书。

  为什么不用 <debug-overrides>：WebView 不认它，而我们要抓的恰恰是 WebView 的流量，
  所以只能写在 base-config 里、靠 debug 源集来保证不外泄。

  门户明文跳转仍由 PortalBindPage 的 _rewriteToHttps 统一改写成 https。
  仅地图服务器与本机测试地址允许 HTTP，不改变其他域名的明文访问策略。
-->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain>192.0.2.1</domain>
        <domain>duohuo.org.cn</domain>
        <domain>127.0.0.1</domain>
        <domain>localhost</domain>
        <domain>10.0.2.2</domain>
    </domain-config>
</network-security-config>

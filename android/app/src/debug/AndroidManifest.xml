<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 抓包用：debug 构建信任用户安装的 CA，见 res/xml/network_security_config.xml。 -->
    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- 云测截图用的独立测量入口，仅随 debug APK 提供。 -->
        <receiver
            android:name=".widget.WidgetMeasure2x2Receiver"
            android:exported="true"
            android:label="@string/wg_measure_2x2_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_measure_2x2_info"/>
        </receiver>
        <receiver
            android:name=".widget.WidgetMeasure4x2Receiver"
            android:exported="true"
            android:label="@string/wg_measure_4x2_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_measure_4x2_info"/>
        </receiver>
    </application>
</manifest>

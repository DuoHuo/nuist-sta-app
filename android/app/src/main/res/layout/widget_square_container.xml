<?xml version="1.0" encoding="utf-8"?>
<!-- 先按实际宽高求短边高度，再以该高度求等宽；不使用 Glance 上报尺寸。 -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/wg_square_height"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:adjustViewBounds="true"
        android:src="@drawable/wg_square_ratio"
        android:visibility="invisible"
        android:importantForAccessibility="no"/>
    <ImageView
        android:id="@+id/wg_square_bounds"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignTop="@id/wg_square_height"
        android:layout_alignBottom="@id/wg_square_height"
        android:layout_centerHorizontal="true"
        android:adjustViewBounds="true"
        android:src="@drawable/wg_square_ratio"
        android:visibility="invisible"
        android:importantForAccessibility="no"/>
    <FrameLayout
        android:id="@+id/wg_square_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignLeft="@id/wg_square_bounds"
        android:layout_alignRight="@id/wg_square_bounds"
        android:layout_alignTop="@id/wg_square_bounds"
        android:layout_alignBottom="@id/wg_square_bounds"/>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2「今日课表」（design-widget-4x2/spec-widget-4x2.md，基准 320×168dp，最小 250×110，圆角 16）：控件 id 为原生渲染契约，UI 可调整样式但需保留 id。
     各状态用 setViewVisibility 切换 wg_group_main / wg_group_empty。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_bg"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/wg_header_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/wg_t2"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/wg_header_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/wg_link"
                android:textSize="11sp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- 主区：头部以下。wg_main_area 占剩余高度并垂直居中（后续行全 GONE 时主块居中，
             spec §11）；wg_more 固定在底部。 -->
        <LinearLayout
            android:id="@+id/wg_group_main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/wg_main_area"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

            <!-- §13 统一主块：课名 + 副行 + 倒计时，最小高度 50dp。 -->
            <LinearLayout
                android:id="@+id/wg_main"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:minHeight="50dp"
                android:background="@drawable/wg_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp">
                <ImageView
                    android:id="@+id/wg_main_bar"
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/wg_bar"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/wg_main_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/wg_t1"
                        android:textSize="15sp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/wg_main_loc"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@color/wg_t3"
                            android:textSize="11sp"/>
                        <TextView
                            android:id="@+id/wg_main_teacher"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="@color/wg_t3"
                            android:textSize="11sp"
                            android:visibility="gone"/>
                        <TextView
                            android:id="@+id/wg_main_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="@color/wg_t3"
                            android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>
                <!-- 倒计时列：固定 64dp，主区先让出宽度，避免秒数 / 时间被截断；
                     主区 weight=1 先让出宽度。 -->
                <LinearLayout
                    android:layout_width="64dp"
                    android:minWidth="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:gravity="end"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/wg_main_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textColor="@color/wg_acc"
                        android:textSize="10sp"/>
                    <Chronometer
                        android:id="@+id/wg_main_chrono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:fontFeatureSettings="tnum"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textColor="@color/wg_acc"
                        android:textStyle="bold"
                        android:textSize="17sp"/>
                    <TextView
                        android:id="@+id/wg_main_static"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:fontFeatureSettings="tnum"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textColor="@color/wg_t2"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 同时显示 2 节（widgetCourseCount=2）：第 2 节也用主块样式，块高 50、间距 4，
                 右列静态「上课 / 13:45」。默认 GONE，由原生端按高度决定是否显示。 -->
            <LinearLayout
                android:id="@+id/wg_main2"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/wg_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/wg_main2_bar"
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/wg_bar"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/wg_main2_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/wg_t1"
                        android:textSize="15sp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/wg_main2_loc"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@color/wg_t3"
                            android:textSize="11sp"/>
                        <TextView
                            android:id="@+id/wg_main2_teacher"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="@color/wg_t3"
                            android:textSize="11sp"
                            android:visibility="gone"/>
                        <TextView
                            android:id="@+id/wg_main2_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="@color/wg_t3"
                            android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>
                <!-- 第二主块倒计时列：与主块同宽（64dp），静态开始时间不省略。 -->
                <LinearLayout
                    android:layout_width="64dp"
                    android:minWidth="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:gravity="end"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/wg_main2_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:maxLines="1"
                        android:text="上课"
                        android:textColor="@color/wg_t3"
                        android:textSize="10sp"/>
                    <TextView
                        android:id="@+id/wg_main2_start"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:fontFeatureSettings="tnum"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textStyle="bold"
                        android:textColor="@color/wg_t2"
                        android:textSize="17sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wg_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">
            <LinearLayout
                android:id="@+id/wg_row1"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/wg_row1_bar"
                    android:layout_width="3dp"
                    android:layout_height="14dp"
                    android:src="@drawable/wg_bar"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no"/>
                <TextView
                    android:id="@+id/wg_row1_name"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/wg_t1"
                    android:textSize="13sp"/>
                <TextView
                    android:id="@+id/wg_row1_loc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/wg_t3"
                    android:textSize="11sp"/>
                <TextView
                    android:id="@+id/wg_row1_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:textColor="@color/wg_t3"
                    android:textSize="11sp"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/wg_row2"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/wg_row2_bar"
                    android:layout_width="3dp"
                    android:layout_height="14dp"
                    android:src="@drawable/wg_bar"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no"/>
                <TextView
                    android:id="@+id/wg_row2_name"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/wg_t1"
                    android:textSize="13sp"/>
                <TextView
                    android:id="@+id/wg_row2_loc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/wg_t3"
                    android:textSize="11sp"/>
                <TextView
                    android:id="@+id/wg_row2_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:textColor="@color/wg_t3"
                    android:textSize="11sp"/>
            </LinearLayout>
            </LinearLayout>
            </LinearLayout>

            <!-- §13 统一「之后」行：下一节 / 今天最后一节。 -->
            <TextView
                android:id="@+id/wg_more"
                android:ellipsize="end"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:paddingStart="11dp"
                android:maxLines="1"
                android:textColor="@color/wg_link"
                android:textSize="11sp"
                android:visibility="gone"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wg_group_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/wg_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/wg_t1"
                android:textSize="15sp"
                android:text="今日课表"/>
            <TextView
                android:id="@+id/wg_empty_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:gravity="center"
                android:textColor="@color/wg_t3"
                android:textSize="11sp"/>
            <TextView
                android:id="@+id/wg_empty_button"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/wg_button"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/wg_on_acc"
                android:textSize="11sp"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

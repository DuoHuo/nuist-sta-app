<?xml version="1.0" encoding="utf-8"?>
<!-- 同日课程块均衡占用高度、固定间距，仅隔天分隔；最后一节提示贴底。 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_bg"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:minHeight="16dp"
            android:id="@+id/wg_header"
            android:baselineAligned="true"
            android:gravity="top">
            <TextView
                android:id="@+id/wg_header_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/wg_t2"
                android:textSize="12sp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:text="今日课表"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/wg_header_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/wg_link"
                android:textSize="12sp"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/wg_header_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textColor="@color/wg_t2"
                android:textSize="11sp"
                android:includeFontPadding="false"
                android:text="10/28" />
            <TextView
                android:id="@+id/wg_header_weekday"
                android:translationY="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:maxLines="1"
                android:textColor="@color/wg_weekday"
                android:textSize="11sp"
                android:includeFontPadding="false"
                android:text="周三" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:id="@+id/wg_group_main">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="top"
                android:id="@+id/wg_main_area">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/wg_main"
                    android:background="@drawable/wg_chip"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp">
                    <LinearLayout
                        android:id="@+id/wg_main_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_gravity="center_vertical"
                        android:baselineAligned="false"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/wg_main_bar"
                            android:layout_width="4dp"
                            android:layout_height="match_parent"
                            android:src="@drawable/wg_bar"
                            android:scaleType="fitXY"
                            android:importantForAccessibility="no" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp">
                            <TextView
                                android:id="@+id/wg_main_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:textColor="@color/wg_t1"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-medium"
                                android:ellipsize="end"
                                android:text="高等数学 A"
                                android:includeFontPadding="false" />
                            <TextView
                                android:id="@+id/wg_main_loc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/wg_t3"
                                android:textSize="11sp"
                                android:ellipsize="end"
                                android:text="示例教室 A101"
                                android:includeFontPadding="false" />
                            <!-- 时段混有中文节次，保留字体上下边界，避免系统字体裁切。 -->
                            <TextView
                                android:id="@+id/wg_main_time"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/wg_t3"
                                android:textSize="10sp"
                                android:text="第3–4节 · 10:10–11:50"
                                android:includeFontPadding="true"
                                android:fallbackLineSpacing="true" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:minWidth="68dp"
                            android:layout_marginStart="8dp"
                            android:gravity="end"
                            android:id="@+id/wg_main_clock">
                            <TextView
                                android:id="@+id/wg_main_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:textColor="@color/wg_acc"
                                android:textSize="10sp"
                                android:text="距下课"
                                android:includeFontPadding="false" />
                            <TextView
                                android:id="@+id/wg_main_static"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:textColor="@color/wg_acc"
                                android:textSize="17sp"
                                android:fontFamily="sans-serif"
                                android:fontFeatureSettings="tnum"
                                android:textStyle="bold"
                                android:text="49 分钟"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/wg_status"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/wg_t3"
                android:textSize="12sp"
                android:includeFontPadding="false"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/wg_course_gap"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:importantForAccessibility="no" />
            <ImageView
                android:id="@+id/wg_after_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:background="@color/wg_divider"
                android:visibility="gone"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:id="@+id/wg_rows">
                <FrameLayout
                    android:id="@+id/wg_row1"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="0dp">
                    <FrameLayout
                        android:id="@+id/wg_row1_course"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:minHeight="0dp"
                        android:background="@drawable/wg_chip"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp">
                        <LinearLayout
                            android:id="@+id/wg_row1_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView
                                android:id="@+id/wg_row1_bar"
                                android:layout_width="4dp"
                                android:layout_height="match_parent"
                                android:src="@drawable/wg_bar"
                                android:scaleType="fitXY"
                                android:importantForAccessibility="no" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/wg_row1_name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/wg_t1"
                                    android:textSize="14sp"
                                    android:includeFontPadding="false"
                                    android:text="大学英语" />
                                <TextView
                                    android:id="@+id/wg_row1_loc"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:textColor="@color/wg_t3"
                                    android:textSize="11sp"
                                    android:includeFontPadding="false"
                                    android:text="示例教室 C102" />
                                <!-- 时段混有中文节次，保留字体上下边界，避免系统字体裁切。 -->
                                <TextView
                                    android:id="@+id/wg_row1_range"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:textColor="@color/wg_t3"
                                    android:textSize="10sp"
                                    android:includeFontPadding="true"
                                    android:fallbackLineSpacing="true"
                                    android:text="第5–6节 · 13:45–15:20" />
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/wg_row1_clock"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="64dp"
                                android:layout_marginStart="8dp"
                                android:gravity="end"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/wg_row1_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:textColor="@color/wg_t3"
                                    android:textSize="10sp"
                                    android:includeFontPadding="false"
                                    android:text="上课" />
                                <TextView
                                    android:id="@+id/wg_row1_time"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:fontFamily="sans-serif-medium"
                                    android:fontFeatureSettings="tnum"
                                    android:textColor="@color/wg_t1"
                                    android:textSize="15sp"
                                    android:includeFontPadding="false"
                                    android:text="13:45" />
                            </LinearLayout>
                        </LinearLayout>
                    </FrameLayout>
                    <TextView
                        android:id="@+id/wg_tomorrow_free"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/wg_t3"
                        android:textSize="12sp"
                        android:visibility="gone"
                        android:text="明天没课"
                        android:includeFontPadding="false" />
                </FrameLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp"
                    android:minHeight="24dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:visibility="gone"
                    android:id="@+id/wg_row2"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/wg_row2_bar"
                        android:layout_width="4dp"
                        android:layout_height="16dp"
                        android:src="@drawable/wg_bar"
                        android:scaleType="fitXY"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:id="@+id/wg_row2_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textColor="@color/wg_t1"
                        android:textSize="13sp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false" />
                    <TextView
                        android:id="@+id/wg_row2_loc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textColor="@color/wg_t3"
                        android:textSize="11sp"
                        android:maxWidth="100dp"
                        android:layout_marginStart="8dp"
                        android:ellipsize="end"
                        android:visibility="gone"
                        android:includeFontPadding="false" />
                    <TextView
                        android:id="@+id/wg_row2_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:textColor="@color/wg_t3"
                        android:textSize="12sp"
                        android:layout_marginStart="8dp"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/wg_bottom_space"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/wg_more"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/wg_t3"
                android:textSize="10sp"
                android:includeFontPadding="false"
                android:visibility="gone"
                android:text="今天最后一节" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:layout_weight="1"
            android:gravity="center"
            android:visibility="gone"
            android:id="@+id/wg_group_empty">
            <TextView
                android:id="@+id/wg_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textColor="@color/wg_t1"
                android:textSize="15sp"
                android:ellipsize="end"
                android:gravity="center"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/wg_empty_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="3"
                android:textColor="@color/wg_t3"
                android:textSize="11sp"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/wg_empty_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/wg_on_acc"
                android:textSize="12sp"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/wg_button"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:visibility="gone"
                android:ellipsize="end"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

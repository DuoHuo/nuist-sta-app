<?xml version="1.0" encoding="utf-8"?>
<!-- 文字容器决定自然高度，色条只贴齐其上下边界，不参与撑高课程行。 -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/wg_course_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp" />
    <ImageView
        android:id="@+id/wg_course_bar"
        android:layout_width="4dp"
        android:layout_height="0dp"
        android:layout_alignParentStart="true"
        android:layout_alignTop="@id/wg_course_content"
        android:layout_alignBottom="@id/wg_course_content"
        android:src="@drawable/wg_bar"
        android:scaleType="fitXY"
        android:importantForAccessibility="no" />
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- 同日课程组整体居中、固定间距，仅隔天分隔；最后一节课程靠上、提示贴底。 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg2_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/wg2_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/wg_bg"
        android:padding="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:minHeight="16dp"
                android:id="@+id/wg2_header"
                android:baselineAligned="true"
                android:gravity="top">
                <TextView
                    android:id="@+id/wg2_header_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/wg_t2"
                    android:textSize="11sp"
                    android:includeFontPadding="false"
                    android:text="我的课表" />
                <TextView
                    android:id="@+id/wg2_header_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/wg_t2"
                    android:textSize="10sp"
                    android:ellipsize="end"
                    android:text="10/28"
                    android:includeFontPadding="false"
                    android:layout_marginStart="4dp" />
                <TextView
                    android:id="@+id/wg2_header_weekday"
                android:translationY="1dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:maxLines="1"
                    android:textColor="@color/wg_weekday"
                    android:textSize="10sp"
                    android:includeFontPadding="false"
                    android:text="周三" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_marginTop="4dp"
                android:id="@+id/wg2_group_main">
                <LinearLayout
                    android:id="@+id/wg2_main_space_top"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/wg2_main_area">
                    <FrameLayout
                        android:id="@+id/wg2_main"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/wg2_main_bar"
                            android:layout_width="4dp"
                            android:layout_height="match_parent"
                            android:src="@drawable/wg_bar"
                            android:scaleType="fitXY"
                            android:importantForAccessibility="no" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="12dp">
                            <TextView
                                android:id="@+id/wg2_main_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:textColor="@color/wg_t1"
                                android:textSize="16sp"
                                android:fontFamily="sans-serif-medium"
                                android:ellipsize="end"
                                android:text="高等数学 A"
                                android:includeFontPadding="false" />
                            <TextView
                                android:id="@+id/wg2_main_loc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/wg_t3"
                                android:textSize="11sp"
                                android:ellipsize="end"
                                android:text="示例教室 A101"
                                android:includeFontPadding="false" />
                            <TextView
                                android:id="@+id/wg2_main_time"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/wg_t3"
                                android:textSize="11sp"
                                android:text="10:10–11:50"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/wg2_status"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="@color/wg_t3"
                    android:textSize="12sp"
                    android:includeFontPadding="false"
                    android:visibility="gone" />
                <LinearLayout
                    android:id="@+id/wg2_course_gap"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:importantForAccessibility="no" />
                <ImageView
                    android:id="@+id/wg2_after_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:background="@color/wg_divider"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />
                <FrameLayout
                    android:id="@+id/wg2_after"
                    android:layout_width="match_parent"
                    android:layout_height="42dp">
                    <FrameLayout
                        android:id="@+id/wg2_after_course"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical">
                        <ImageView
                            android:id="@+id/wg2_after_bar"
                            android:layout_width="4dp"
                            android:layout_height="match_parent"
                            android:src="@drawable/wg_bar"
                            android:scaleType="fitXY"
                            android:importantForAccessibility="no"
                            />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="12dp">
                            <TextView
                                android:id="@+id/wg2_after_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:textColor="@color/wg_t1"
                                android:textSize="12sp"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:text="大学英语"
                                android:includeFontPadding="false" />
                            <TextView
                                android:id="@+id/wg2_after_detail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/wg_t3"
                                android:textSize="11sp"
                                android:ellipsize="end"
                                android:text="之后 13:45 · C102"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                    </FrameLayout>
                    <TextView
                        android:id="@+id/wg2_tomorrow_free"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/wg_t3"
                        android:textSize="12sp"
                        android:includeFontPadding="false"
                        android:visibility="gone"
                        android:text="明天没课" />
                </FrameLayout>
                <LinearLayout
                    android:id="@+id/wg2_main_space_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <TextView
                    android:id="@+id/wg2_last"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/wg_t3"
                    android:textSize="10sp"
                    android:includeFontPadding="false"
                    android:visibility="gone"
                    android:text="今天最后一节" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:layout_weight="1"
                android:gravity="center"
                android:visibility="gone"
                android:id="@+id/wg2_group_empty">
                <TextView
                    android:id="@+id/wg2_empty_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:textColor="@color/wg_t1"
                    android:textSize="15sp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false" />
                <TextView
                    android:id="@+id/wg2_empty_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="3"
                    android:textColor="@color/wg_t3"
                    android:textSize="11sp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:includeFontPadding="false" />
                <TextView
                    android:id="@+id/wg2_empty_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/wg_on_acc"
                    android:textSize="12sp"
                    android:minHeight="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/wg_button"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:visibility="gone"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>

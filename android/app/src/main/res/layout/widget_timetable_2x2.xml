<?xml version="1.0" encoding="utf-8"?>
<!-- §14 新版：主课 + 之后四态；不显示倒计时与剩余数量，所有文字单行省略。 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg2_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wg_bg"
    android:paddingStart="10dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/wg2_header"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/wg2_header_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:textColor="@color/wg_t2"
                android:textSize="11sp"
                android:text="我的课表"
                android:layout_weight="1"/>
            <TextView
                android:id="@+id/wg2_header_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:textColor="@color/wg_t2"
                android:textSize="10sp"/>
            <TextView
                android:id="@+id/wg2_header_weekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:textColor="@color/wg_acc"
                android:textSize="10sp"
                android:layout_marginStart="3dp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/wg2_group_main"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/wg2_main_area"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/wg2_main_bar"
                    android:layout_width="4dp"
                    android:layout_marginEnd="8dp"
                    android:layout_height="64dp"
                    android:src="@drawable/wg_bar"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/wg2_main_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/wg_t1"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/wg2_main_loc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/wg_t2"
                        android:textSize="11sp"
                        android:layout_marginTop="3dp"/>
                    <TextView
                        android:id="@+id/wg2_main_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/wg_t3"
                        android:textSize="11sp"
                        android:layout_marginTop="3dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/wg2_after"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/wg2_after_bar"
                    android:layout_width="4dp"
                    android:layout_marginEnd="8dp"
                    android:layout_height="34dp"
                    android:src="@drawable/wg_bar"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no"/>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/wg2_after_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/wg_t1"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/wg2_after_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/wg_t3"
                        android:textSize="10sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <!-- 空状态 / 未登录 / 失败：同一 layout 切换，不换布局避免闪烁。 -->
        <LinearLayout
            android:id="@+id/wg2_group_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/wg2_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/wg_t1"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/wg2_empty_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:maxLines="3"
                android:ellipsize="end"
                android:textColor="@color/wg_t3"
                android:textSize="11sp"/>
            <TextView
                android:id="@+id/wg2_empty_button"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/wg_button"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/wg_on_acc"
                android:textSize="11sp"
                android:visibility="gone"/>
            <TextView
                android:id="@+id/wg2_empty_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/wg_link"
                android:textSize="11sp"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:background="@drawable/wg_week_bg"
    android:backgroundTint="@android:color/transparent"
    android:clipToOutline="true">

    <ImageView android:id="@+id/wg_week_background" android:layout_width="match_parent" android:layout_height="match_parent"
        android:importantForAccessibility="no" android:scaleType="fitXY" />

    <FrameLayout android:id="@+id/wg_week_open" android:layout_width="match_parent" android:layout_height="match_parent" />

    <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <!-- 空容器只测量大小；完整 RemoteViews 更新通过 padding 写入实际高度。 -->
        <FrameLayout android:id="@+id/wg_week_header_size" android:layout_width="0dp"
            android:layout_height="wrap_content" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:layout_alignTop="@id/wg_week_header_size" android:layout_alignBottom="@id/wg_week_header_size"
            android:layout_marginTop="14dp" android:translationY="-3dp" android:baselineAligned="false"
            android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="8dp"
            android:paddingTop="3dp" android:paddingBottom="3dp">
            <TextView android:id="@+id/wg_week_title" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="4dp" android:ellipsize="end" android:maxLines="1"
                android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:fallbackLineSpacing="true"
                android:text="@string/wg_week_label" android:textSize="16sp" />
            <TextView android:id="@+id/wg_week_number" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:maxLines="1" android:textSize="11sp"
                android:includeFontPadding="false" android:fallbackLineSpacing="true" />
            <ImageView android:id="@+id/wg_week_flip" android:layout_width="44dp" android:layout_height="match_parent"
                android:paddingStart="13dp" android:paddingEnd="13dp" android:scaleType="fitCenter" android:visibility="gone" />
            <ImageView android:id="@+id/wg_week_settings" android:layout_width="44dp" android:layout_height="match_parent"
                android:paddingStart="13dp" android:paddingEnd="13dp" android:scaleType="fitCenter" android:visibility="gone" />
        </LinearLayout>

        <FrameLayout android:id="@+id/wg_week_weekday_size" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_below="@id/wg_week_header_size" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:layout_alignTop="@id/wg_week_weekday_size" android:layout_alignBottom="@id/wg_week_weekday_size">
            <LinearLayout android:id="@+id/wg_week_current_days" android:layout_width="match_parent"
                android:layout_height="match_parent" android:orientation="horizontal" />
            <LinearLayout android:id="@+id/wg_week_next_days" android:layout_width="match_parent"
                android:layout_height="match_parent" android:orientation="horizontal" android:visibility="gone" />
        </FrameLayout>

        <FrameLayout android:id="@+id/wg_week_content" android:layout_width="match_parent" android:layout_height="match_parent"
            android:layout_below="@id/wg_week_weekday_size" android:layout_alignParentBottom="true" android:paddingBottom="2dp">
            <FrameLayout android:id="@+id/wg_week_grid_layer" android:layout_width="match_parent" android:layout_height="match_parent"
                android:visibility="gone" />
            <LinearLayout android:id="@+id/wg_week_current" android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="horizontal" android:baselineAligned="false"
                android:clipChildren="true" android:clipToPadding="true" />
            <LinearLayout android:id="@+id/wg_week_next" android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="horizontal" android:baselineAligned="false"
                android:clipChildren="true" android:clipToPadding="true" android:visibility="gone" />
            <FrameLayout android:id="@+id/wg_week_periods" android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <LinearLayout android:id="@+id/wg_week_empty" android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="vertical" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:visibility="gone">
                <TextView android:id="@+id/wg_week_empty_title" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:fontFamily="sans-serif-medium"
                    android:gravity="center" android:textSize="17sp" android:maxLines="2" />
                <TextView android:id="@+id/wg_week_empty_hint" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:gravity="center" android:textSize="12sp" android:maxLines="2" />
            </LinearLayout>
        </FrameLayout>
    </RelativeLayout>
</FrameLayout>

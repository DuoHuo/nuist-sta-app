<?xml version="1.0" encoding="utf-8"?>
<!-- 旧系统借助不可见的高条固定节次高度，内容只在同一对边界内测量。 -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:clipChildren="true" android:clipToPadding="true">
    <ImageView android:id="@+id/wg_week_slot_height" android:layout_width="1dp"
        android:layout_height="wrap_content" android:importantForAccessibility="no" android:visibility="invisible" />
    <FrameLayout android:id="@+id/wg_week_slot_content" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_alignTop="@id/wg_week_slot_height"
        android:layout_alignBottom="@id/wg_week_slot_height" android:clipChildren="true" android:clipToPadding="true" />
</RelativeLayout>

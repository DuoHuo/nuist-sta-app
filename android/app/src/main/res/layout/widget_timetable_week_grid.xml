<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="noHideDescendants">
    <LinearLayout android:id="@+id/wg_week_grid_columns"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:baselineAligned="false" />
    <LinearLayout android:id="@+id/wg_week_grid_rows"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" />
    <ImageView android:id="@+id/wg_week_grid_bottom_line"
        android:layout_width="match_parent" android:layout_height="@dimen/wg_week_grid_stroke"
        android:layout_gravity="bottom" />
</FrameLayout>
